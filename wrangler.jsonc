{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dotlog",
	"workers_dev": true,
	"compatibility_date": "2026-11-13",
	"main": "./server/index.ts",
	"upload_source_maps": true,
	"assets": {
		"binding": "ASSETS",
		"html_handling": "none",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Replace both XXX with the ids `pnpm db:create` prints. Local development
	// never reads them, Miniflare keeps its own copy under .wrangler.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dotlog",
			"database_id": "XXX"
		}
	],
	// Preview builds need their own settings. They get a hostname per branch
	// such as search-all-results-dotlog.tryapp.workers.dev, so AUTH_URL
	// stays unset and the code falls back to the origin of the request.
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "dotlog-preview",
				"database_id": "XXX"
			}
		]
	}
}
